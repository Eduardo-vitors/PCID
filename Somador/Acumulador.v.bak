module Acumulador (
    input  wire        clk,
    input  wire [15:0] din,     // dado vindo da SRAM (datain no TOP)
    input  wire        load,    // soma din na soma
    input  wire        clear,   // zera soma
    input  wire        transf,  // transfere soma para dout
    output reg  [15:0] dout     // vai para SRAM como dado de escrita (dataout no TOP)
);

    reg [15:0] sum;

    always @(posedge clk) begin
        if (clear) begin
            sum  <= 16'd0;
            // opcional: você pode zerar dout também, não é obrigatório
        end else if (load) begin
            sum <= sum + din;   // soma em 16 bits (overflow natural)
        end

        // transf: atualiza a saída com a soma atual
        if (transf) begin
            dout <= sum;
        end
    end

endmodule
