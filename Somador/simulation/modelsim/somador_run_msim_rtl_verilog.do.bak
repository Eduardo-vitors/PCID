transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+C:/Trabalho_PCID/Somador {C:/Trabalho_PCID/Somador/TOP.v}
vlog -vlog01compat -work work +incdir+C:/Trabalho_PCID/Somador {C:/Trabalho_PCID/Somador/Acumulador.v}
vlog -vlog01compat -work work +incdir+C:/Trabalho_PCID/Somador {C:/Trabalho_PCID/Somador/FSM.v}

