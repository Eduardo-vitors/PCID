`timescale 1ns/1ps

module tb_Acumulador;

    // -------------------------
    // Sinais do testbench
    // -------------------------
    reg         clk;
    reg         load;
    reg         transf;
    reg         clear;
    reg  [15:0] in;
    wire [15:0] out;

    // -------------------------
    // Instância do DUT
    // -------------------------
    Acumulador dut (
        .clk(clk),
        .in(in),
        .load(load),
        .clear(clear),
        .transf(transf),
        .out(out)
    );

    // -------------------------
    // Geração do clock
    // Período = 10 ns
    // -------------------------
    always #5 clk = ~clk;

    // -------------------------
    // Sequência de estímulos
    // -------------------------
    initial begin
        // Inicialização
        clk    = 0;
        load   = 0;
        transf = 0;
        clear  = 0;
        in     = 16'd0;

        // -------------------------
        // RESET (clear ativo em 0)
        // -------------------------
        #12;
        clear = 1;  // libera o reset

        // -------------------------
        // Teste 1: load = 10, transf
        // -------------------------
        @(negedge clk);
        in   = 16'd10;
        load = 1;

        @(negedge clk);
        load = 0;

        @(negedge clk);
        transf = 1;

        @(negedge clk);
        transf = 0;

        // Esperado: out = 10

        // -------------------------
        // Teste 2: load = 5, transf
        // -------------------------
        @(negedge clk);
        in   = 16'd5;
        load = 1;

        @(negedge clk);
        load = 0;

        @(negedge clk);
        transf = 1;

        @(negedge clk);
        transf = 0;

        // Esperado: out = 15

        // -------------------------
        // Teste 3: load = 20, transf
        // -------------------------
        @(negedge clk);
        in   = 16'd20;
        load = 1;

        @(negedge clk);
        load = 0;

        @(negedge clk);
        transf = 1;

        @(negedge clk);
        transf = 0;

        // Esperado: out = 35

        // -------------------------
        // Teste 4: clear durante operação
        // -------------------------
        @(negedge clk);
        clear = 0;  // zera tudo

        @(negedge clk);
        clear = 1;

        // Esperado: out = 0

        // -------------------------
        // Teste 5: novo valor após clear
        // -------------------------
        @(negedge clk);
        in   = 16'd7;
        load = 1;

        @(negedge clk);
        load = 0;

        @(negedge clk);
        transf = 1;

        @(negedge clk);
        transf = 0;

        // Esperado: out = 7

        // -------------------------
        // Fim da simulação
        // -------------------------
        #20;
        $stop;
    end

endmodule
