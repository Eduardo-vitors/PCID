module TOP (
    input  wire        clk,
    input  wire        reset,
    output wire        ready,
    output wire [4:0]  address,
    output wire        rden,
    output wire        wren,
    output wire [15:0] mem_datain,   // vai PARA a SRAM (data)
    input  wire [15:0] mem_dataout   // vem DA SRAM (q)
);

    wire load, clear, transf;

    Acumulador acc(
        .clk   (clk),
        .din   (mem_dataout),
        .load  (load),
        .clear (clear),
        .transf(transf),
        .dout  (mem_datain)
    );

    FSM fsm(
        .clk   (clk),
        .reset (reset),
        .address(address),
        .rden  (rden),
        .wren  (wren),
        .load  (load),
        .clear (clear),
        .transf(transf),
        .ready (ready)
    );

endmodule
